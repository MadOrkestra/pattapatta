{
  "name": "pattapatta",
  "version": "0.1.0",
  "description": "Pen-plotter geometry library (PGS-inspired): hatching, packing, boolean paths for SVG",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "MadOrkestra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadOrkestra/pattapatta.git"
  },
  "bugs": {
    "url": "https://github.com/MadOrkestra/pattapatta/issues"
  },
  "homepage": "https://github.com/MadOrkestra/pattapatta#readme",
  "keywords": [
    "pen-plotter",
    "svg",
    "geometry",
    "hatching",
    "circle-packing",
    "boolean",
    "clipper",
    "voronoi",
    "pgs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.js"
    },
    "./shapeBoolean": {
      "types": "./dist/shapeBoolean/index.d.ts",
      "import": "./dist/shapeBoolean/index.js"
    },
    "./predicates": {
      "types": "./dist/predicates/index.d.ts",
      "import": "./dist/predicates/index.js"
    },
    "./segmentSet": {
      "types": "./dist/segmentSet/index.d.ts",
      "import": "./dist/segmentSet/index.js"
    },
    "./hatch": {
      "types": "./dist/hatch/index.d.ts",
      "import": "./dist/hatch/index.js"
    },
    "./circlePacking": {
      "types": "./dist/circlePacking/index.d.ts",
      "import": "./dist/circlePacking/index.js"
    },
    "./morphology": {
      "types": "./dist/morphology/index.d.ts",
      "import": "./dist/morphology/index.js"
    },
    "./transformation": {
      "types": "./dist/transformation/index.d.ts",
      "import": "./dist/transformation/index.js"
    },
    "./processing": {
      "types": "./dist/processing/index.d.ts",
      "import": "./dist/processing/index.js"
    },
    "./conversion": {
      "types": "./dist/conversion/index.d.ts",
      "import": "./dist/conversion/index.js"
    },
    "./contour": {
      "types": "./dist/contour/index.d.ts",
      "import": "./dist/contour/index.js"
    },
    "./hull": {
      "types": "./dist/hull/index.d.ts",
      "import": "./dist/hull/index.js"
    },
    "./triangulation": {
      "types": "./dist/triangulation/index.d.ts",
      "import": "./dist/triangulation/index.js"
    },
    "./pointSet": {
      "types": "./dist/pointSet/index.d.ts",
      "import": "./dist/pointSet/index.js"
    },
    "./optimisation": {
      "types": "./dist/optimisation/index.d.ts",
      "import": "./dist/optimisation/index.js"
    },
    "./voronoi": {
      "types": "./dist/voronoi/index.d.ts",
      "import": "./dist/voronoi/index.js"
    },
    "./construction": {
      "types": "./dist/construction/index.d.ts",
      "import": "./dist/construction/index.js"
    },
    "./tiling": {
      "types": "./dist/tiling/index.d.ts",
      "import": "./dist/tiling/index.js"
    },
    "./polygonisation": {
      "types": "./dist/polygonisation/index.d.ts",
      "import": "./dist/polygonisation/index.js"
    },
    "./meshing": {
      "types": "./dist/meshing/index.d.ts",
      "import": "./dist/meshing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pattapatta": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:examples": "pnpm run build && node scripts/generate-docs-examples.mjs",
    "docs:dev": "pnpm --filter website dev",
    "docs:build": "pnpm --filter website build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-18",
    "d3-delaunay": "^6.0.4"
  }
}
